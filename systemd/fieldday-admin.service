[Unit]
Description=FieldDay Pi Server Web Admin
After=network.target fieldday-ap-ifup.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/fieldday-admin
ExecStart=/usr/bin/python3 /opt/fieldday-admin/app.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
